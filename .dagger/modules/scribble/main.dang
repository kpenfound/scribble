"""
Build and verify Scribble's Go binary and embedded PWA.
"""
type Scribble {
  """
  Source without local runtime state or generated test reports.
  """
  source(ws: Workspace!): Directory! {
    ws.directory("/", exclude: [".git", "node_modules", "bin", ".local", "test-results", "playwright-report"])
  }

  """
  Build the Linux amd64 service, including its embedded PWA.
  """
  pub build(ws: Workspace!): File! {
    container
      .from("golang:1.25-bookworm")
      .withMountedCache("/go/pkg/mod", cacheVolume("scribble-go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("scribble-go-build"))
      .withDirectory("/src", self.source(ws: ws))
      .withWorkdir("/src")
      .withEnvVariable("CGO_ENABLED", "0")
      .withEnvVariable("GOOS", "linux")
      .withEnvVariable("GOARCH", "amd64")
      .withExec(["go", "build", "-trimpath", "-o", "/out/scribble", "./cmd/scribble"])
      .file("/out/scribble")
  }

  """
  Compile the release artifact as part of every check.
  """
  pub buildCheck(ws: Workspace!): Void @check {
    let artifact = self.build(ws: ws).sync
    null
  }

  """
  Runtime used by the shared Playwright module, including Go for fake providers.
  """
  pub browserRuntime: Container! {
    let go = container.from("golang:1.25-bookworm").directory("/usr/local/go")
    container
      .from("mcr.microsoft.com/playwright:v1.58.2-noble")
      .withDirectory("/usr/local/go", go)
      .withEnvVariable("PATH", "/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
      .withMountedCache("/go/pkg/mod", cacheVolume("scribble-go-mod"))
      .withEnvVariable("GOPATH", "/go")
      .withMountedCache("/root/.cache/go-build", cacheVolume("scribble-go-build"))
  }
}
