[Unit]
Description=Obsidian Headless Sync for Scribble

[Service]
Type=simple
# The vault is %h/vault. If it lives elsewhere, change WorkingDirectory and
# --path below, for example with `systemctl --user edit obsidian-sync`.
WorkingDirectory=%h/vault
# systemd does not search Environment=PATH for ExecStart, so ob needs an
# absolute path. This is the npm user prefix (`npm config set prefix ~/.local`);
# use /usr/local/bin/ob for a global install, or wherever `command -v ob` says.
ExecStart=%h/.local/bin/ob sync --continuous --path %h/vault
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
