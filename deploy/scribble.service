[Unit]
Description=Scribble thought capture

[Service]
Type=simple
WorkingDirectory=%h
# claude (Claude Code) is a runtime dependency found on PATH. This PATH covers
# an npm user prefix at ~/.local and a global install under /usr/local; add the
# directory holding claude if yours differs.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets: TYPESAFE_API_KEY, ANTHROPIC_API_KEY, TS_AUTHKEY (first tailnet login)
# and WHISPER_API_KEY when the transcription server wants one.
EnvironmentFile=%h/.config/scribble/environment
# No --root: state is under $XDG_DATA_HOME/scribble (default ~/.local/share/scribble)
# and the config is $XDG_CONFIG_HOME/scribble/config.toml (default ~/.config).
ExecStart=%h/.local/bin/scribble serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
